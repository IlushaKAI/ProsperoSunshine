+  // Apollo Extended's native DualSense channel, which Artemis Extended speaks: the client asks with 0x5506 every 2 s, the host
+  // answers with an adaptive-trigger message marked 'B' 'W' 'P', and 0x5504 carries the audio. Moonlight proper never asks, and for
+  // it 0x5504 means player LEDs, so nothing here goes to a client that didn't ask. Apollo sends four channels at 48 kHz every 3 ms.
+  // This host has only haptics, at the controller's own 3 kHz, so it sends them as they are: flag 0x04, 47 small packets a second
+  // instead of 333 large ones, which leaves a phone's radio more time for Bluetooth. A client that takes this is a patched one.
+  constexpr std::uint16_t dualsense_policy_type = 0x5506, dualsense_audio_type = 0x5504;
+
+  /**
+   * @brief One block of native DualSense audio, ahead of its PCM.
+   */
+  struct control_dualsense_audio_t {
+    control_header_v2 header;  ///< Control message header preceding this payload.
+    std::uint16_t id;  ///< Controller identifier, always the first.
+    std::uint16_t sequence;  ///< Counts the blocks, for the client's reorder window.
+    std::uint16_t frame_count;  ///< Frames in this block.
+    std::uint8_t channels;  ///< Channels in the PCM.
+    std::uint8_t flags;  ///< 0x03: speaker and haptic channels are present.
+  };
+
+  static std::mutex dualsense_haptics_mutex;
+  static std::deque<std::array<std::uint8_t, dualsense_haptics_block_bytes>> dualsense_haptics_blocks;
+  static std::atomic<std::int64_t> dualsense_haptics_until_ms {0};
+  static std::uint16_t dualsense_haptics_sequence = 0;
+
+  static std::int64_t dualsense_now_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+
+  static std::atomic<int> dualsense_power_reduction {3};
+
+  void dualsense_set_power_reduction(int steps) {
+    dualsense_power_reduction.store(steps, std::memory_order_relaxed);
+  }
+
+  bool dualsense_haptics_wanted() {
+    return dualsense_now_ms() < dualsense_haptics_until_ms.load(std::memory_order_relaxed);
+  }
+
+  void dualsense_haptics_push(const std::uint8_t *pcm) {
+    std::lock_guard lock {dualsense_haptics_mutex};
+    // 85 ms at most: late vibration is worse than a gap.
+    if (dualsense_haptics_blocks.size() >= 4) {
+      dualsense_haptics_blocks.pop_front();
+    }
+    auto &block = dualsense_haptics_blocks.emplace_back();
+    std::copy_n(pcm, block.size(), block.begin());
+  }
+
+  static void send_dualsense_policy_ack(session_t *session, bool enabled, std::uint16_t request) {
+    control_adaptive_triggers_t plaintext {};
+    plaintext.header.type = packetTypes[IDX_SET_ADAPTIVE_TRIGGERS];
+    plaintext.header.payloadLength = sizeof(plaintext) - sizeof(control_header_v2);
+    plaintext.event_flags = 0x40;
+    plaintext.type_left = 0x42;  // 'B'
+    plaintext.type_right = 0x57;  // 'W'
+    plaintext.left[0] = 0x50;  // 'P'
+    plaintext.left[1] = 1;
+    plaintext.left[2] = enabled ? 1 : 0;
+    plaintext.left[3] = 0;
+    plaintext.left[4] = (std::uint8_t) request;
+    plaintext.left[5] = (std::uint8_t) (request >> 8);
+    plaintext.left[6] = (std::uint8_t) dualsense_power_reduction.load(std::memory_order_relaxed);  // our client's extension
+
+    std::array<std::uint8_t, sizeof(control_encrypted_t) + crypto::cipher::round_to_pkcs7_padded(sizeof(plaintext)) + crypto::cipher::tag_size + sizeof(control_header_v2)> encrypted_payload;
+    auto payload = encode_control(session, util::view(plaintext), encrypted_payload);
+    session->broadcast_ref->control_server.send(payload, session->control.peer);
+  }
+
+  static void send_dualsense_block(session_t *session, const std::array<std::uint8_t, dualsense_haptics_block_bytes> &pcm, std::uint16_t sequence) {
+    constexpr auto plaintext_size = sizeof(control_dualsense_audio_t) + dualsense_haptics_block_bytes;
+    std::array<std::uint8_t, plaintext_size> buffer {};
+    auto *plaintext = reinterpret_cast<control_dualsense_audio_t *>(buffer.data());
+    plaintext->header.type = dualsense_audio_type;
+    plaintext->header.payloadLength = plaintext_size - sizeof(control_header_v2);
+    plaintext->id = 0;
+    plaintext->sequence = sequence;
+    plaintext->frame_count = 32;
+    plaintext->channels = 2;
+    plaintext->flags = 0x04;
+    std::copy(pcm.begin(), pcm.end(), buffer.begin() + sizeof(control_dualsense_audio_t));
+
+    std::array<std::uint8_t, sizeof(control_encrypted_t) + crypto::cipher::round_to_pkcs7_padded(plaintext_size) + crypto::cipher::tag_size + sizeof(control_header_v2)> encrypted_payload;
+    auto payload = encode_control(session, util::view(buffer), encrypted_payload);
+    // Real time, and independent of the reliable sequence: the client has a reorder window for it.
+    session->broadcast_ref->control_server.send(payload, session->control.peer, ENET_PACKET_FLAG_UNSEQUENCED);
+  }
