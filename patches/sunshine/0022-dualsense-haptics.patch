   void controlBroadcastThread(control_server_t *server) {
+    server->map(0x5507, [](session_t *session, const std::string_view &payload) {
+      // The client's Bluetooth counters, as text: the phone's own log is out of reach.
+      std::string text {payload.substr(0, 240)};
+      for (auto &character : text) {
+        if (character < 0x20 || character > 0x7e) {
+          character = '?';
+        }
+      }
+      BOOST_LOG(info) << "Client Bluetooth: "sv << text;
+    });
+
+    server->map(dualsense_policy_type, [](session_t *session, const std::string_view &payload) {
+      // Version, enable, lease in ms, request id, reserved.
+      if (payload.size() < 8 || (std::uint8_t) payload[0] != 1) {
+        return;
+      }
+      const auto byte = [&](int index) {
+        return (std::uint32_t) (std::uint8_t) payload[index];
+      };
+      const bool enabled = byte(1) != 0;
+      const auto lease = byte(2) | byte(3) << 8;
+      const auto request = (std::uint16_t) (byte(4) | byte(5) << 8);
+      const bool was_wanted = dualsense_haptics_wanted();
+      dualsense_haptics_until_ms.store(enabled ? dualsense_now_ms() + lease : 0, std::memory_order_relaxed);
+      if (enabled != was_wanted) {
+        BOOST_LOG(info) << "Native DualSense haptics "sv << (enabled ? "requested"sv : "stopped"sv) << " by the client"sv;
+      }
+      send_dualsense_policy_ack(session, enabled, request);
+    });
+
     server->map(packetTypes[IDX_PERIODIC_PING], [](session_t *session, const std::string_view &payload) {
       BOOST_LOG(verbose) << "type [IDX_PERIODIC_PING]"sv;
